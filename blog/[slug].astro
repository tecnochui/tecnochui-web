---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

/**
 * Astro 7 / Content Layer API: cada entrada usa `id` como slug de ruta.
 */
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('es-VE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={`tecnochui | ${post.data.title}`} description={post.data.description}>
  <a
    href="/blog/"
    class="inline-flex items-center gap-2 text-sm text-secondary hover:text-primary transition mb-6"
  >
    <span class="text-gray-500">$</span> cd ..
  </a>

  <article class="panel p-6 md:p-8">
    <header class="mb-8 pb-6 border-b border-gray-700">
      <div class="flex flex-wrap gap-2 mb-4">
        {post.data.tags.map((tag) => (
          <span class="badge text-gray-400">#{tag}</span>
        ))}
      </div>

      <h1 class="font-display text-2xl md:text-3xl font-bold text-white leading-tight">
        {post.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-xs text-gray-500 mt-4">
        <span class="text-secondary">{post.data.author}</span>
        <span class="w-1 h-1 rounded-full bg-gray-600"></span>
        <span>{dateFormatter.format(post.data.pubDate)}</span>
        <span class="w-1 h-1 rounded-full bg-gray-600"></span>
        <span>{post.data.readingTime} de lectura</span>
      </div>
    </header>

    <div class="prose-terminal">
      <Content />
    </div>
  </article>

  <a
    href="/blog/"
    class="inline-flex items-center gap-2 text-sm text-secondary hover:text-primary transition mt-6"
  >
    <span class="text-gray-500">$</span> cd ..
  </a>
</Layout>
