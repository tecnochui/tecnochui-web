---
import Layout from '../layouts/Layout.astro';
import { SITE, waLink, WA_DIAGNOSTICO } from '../data/site.js';

const tiposServicio = [
  { value: 'soporte-tecnico', label: 'Soporte técnico' },
  { value: 'infraestructura', label: 'Servidores e infraestructura' },
  { value: 'virtualizacion', label: 'Virtualización y nube privada' },
  { value: 'redes', label: 'Redes y conectividad' },
  { value: 'ciberseguridad', label: 'Ciberseguridad y firewalls' },
  { value: 'capacitacion-ia', label: 'Capacitación, IA y gobierno digital' },
  { value: 'no-lo-se', label: 'No estoy seguro / otro' },
];

const canales = [
  { label: 'WhatsApp', value: SITE.telefono, href: waLink(WA_DIAGNOSTICO) },
  { label: 'Correo', value: SITE.email, href: `mailto:${SITE.email}` },
  { label: 'Telegram', value: '@tecnochui', href: 'https://t.me/tecnochui' },
];
---

<Layout
  title="Contacto y diagnóstico gratis | Tecnochui"
  description="Pide tu diagnóstico gratis de soporte técnico, redes, servidores o ciberseguridad en Caracas. Respondo en menos de 2 horas en horario laboral."
>
  <div class="mb-8">
    <div class="term-only items-center gap-2 text-sm text-gray-400 mb-2">
      <span class="text-primary">$</span>
      <span class="text-white">./contactar</span>
      <span class="text-secondary">--nuevo-ticket</span>
      <span class="ml-auto text-xs badge text-gray-400">[ RESPUESTA &lt; 2H ]</span>
    </div>
    <h1 class="font-display text-3xl md:text-4xl font-bold text-white">Pide tu diagnóstico gratis</h1>
    <p class="text-gray-300 mt-3 max-w-2xl leading-relaxed">
      Cuéntame qué está pasando y te respondo con un plan de acción. El diagnóstico es gratis; si hace
      falta una visita técnica en sitio, se cotiza aparte.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    <!-- Formulario -->
    <div class="panel panel-static panel-glow lg:col-span-2 overflow-hidden">
      <div class="term-only items-center gap-2 px-4 py-3 border-b border-gray-700 bg-bg-raised">
        <span class="w-2.5 h-2.5 rounded-full bg-gray-600"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-gray-600"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
        <span class="ml-3 text-xs text-gray-400">ticket.form — tecnochui</span>
      </div>

      <form id="contact-form" action={SITE.formEndpoint} method="POST" class="p-5 md:p-6 space-y-5">
        <input type="hidden" name="_subject" value="Nueva solicitud de diagnóstico — tecnochui.com.ve" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div>
          <label for="nombre" class="block text-sm font-semibold text-gray-200 mb-1.5">Nombre o empresa</label>
          <input id="nombre" name="nombre" type="text" required placeholder="Ej. María Pérez — Comercial XYZ" class="field" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-200 mb-1.5">Correo electrónico</label>
            <input id="email" name="email" type="email" required placeholder="tu@correo.com" class="field" />
          </div>
          <div>
            <label for="telefono" class="block text-sm font-semibold text-gray-200 mb-1.5">
              WhatsApp o teléfono <span class="font-normal text-gray-500">(opcional)</span>
            </label>
            <input id="telefono" name="telefono" type="tel" placeholder="+58 424 289 0416" class="field" />
          </div>
        </div>

        <div>
          <label for="servicio" class="block text-sm font-semibold text-gray-200 mb-1.5">¿Con qué necesitas ayuda?</label>
          <select id="servicio" name="servicio" required class="field">
            <option value="" disabled selected>Selecciona una opción…</option>
            {tiposServicio.map((t) => <option value={t.value}>{t.label}</option>)}
          </select>
        </div>

        <div>
          <label for="mensaje" class="block text-sm font-semibold text-gray-200 mb-1.5">Cuéntame qué está pasando</label>
          <textarea
            id="mensaje"
            name="mensaje"
            required
            rows="5"
            placeholder="Ej.: Tenemos 8 PC en la oficina y el internet se cae varias veces al día…"
            class="field resize-y"
          ></textarea>
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-1">
          <button type="submit" id="submit-btn" class="btn-primary">Enviar solicitud</button>
          <span id="form-status" class="text-sm text-gray-400" role="status" aria-live="polite"></span>
        </div>
      </form>
    </div>

    <!-- Canales directos -->
    <div class="panel panel-static p-5 space-y-5">
      <div>
        <h2 class="font-display text-lg font-bold text-white mb-3">Prefiero escribir directo</h2>
        <ul class="space-y-3 text-sm">
          {canales.map((c) => (
            <li>
              <p class="text-xs text-gray-500 uppercase tracking-wide">{c.label}</p>
              <a href={c.href} target="_blank" rel="noopener noreferrer" class="text-gray-100 hover:text-primary transition break-words font-semibold">
                {c.value}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <hr class="divider" />

      <div>
        <p class="text-sm text-gray-200">
          <span class="text-primary font-bold">Respuesta en menos de 2 horas</span> en horario laboral.
        </p>
        <p class="text-xs text-gray-500 leading-relaxed mt-2">
          Atiendo en {SITE.ciudad}, {SITE.pais}. Muchos casos se resuelven de forma remota.
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const status = document.getElementById('form-status');

  // Preselecciona el servicio si viene en la URL: /contacto?servicio=redes
  const pre = new URLSearchParams(window.location.search).get('servicio');
  const select = document.getElementById('servicio') as HTMLSelectElement | null;
  if (pre && select && Array.from(select.options).some((o) => o.value === pre)) {
    select.value = pre;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submitBtn || !status) return;

    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-60', 'cursor-not-allowed');
    status.className = 'text-sm text-gray-400';
    status.textContent = 'Enviando…';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        status.className = 'text-sm text-primary font-semibold';
        status.textContent = '¡Mensaje enviado! Te respondo en menos de 2 horas en horario laboral.';
        form.reset();
      } else {
        status.className = 'text-sm text-secondary font-semibold';
        status.textContent = 'No se pudo enviar. Inténtalo de nuevo o escríbeme por WhatsApp.';
      }
    } catch {
      status.className = 'text-sm text-secondary font-semibold';
      status.textContent = 'Error de red. Inténtalo de nuevo o escríbeme por WhatsApp.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.classList.remove('opacity-60', 'cursor-not-allowed');
    }
  });
</script>
