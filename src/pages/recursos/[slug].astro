---
import Layout from '../../layouts/Layout.astro';
import { recursos } from '../../data/recursos.js';
import { getServicio } from '../../data/servicios.js';
import { SITE, waLink } from '../../data/site.js';

export function getStaticPaths() {
  return recursos.map((r) => ({ params: { slug: r.slug }, props: { recurso: r } }));
}

const { recurso: r } = Astro.props;
const servicio = getServicio(r.servicio);
const mensaje = `Hola Jesús, hice el «${r.titulo}» de tu web y quiero que me ayudes a revisarlo (diagnóstico gratis).`;

const largo = `${r.desc} Checklist gratuito de ${r.items.length} puntos para pymes, para marcar o guardar como PDF.`;
const medio = `${r.desc} Checklist gratuito de ${r.items.length} puntos para pymes y oficinas en Venezuela, para marcar o guardar como PDF.`;
const descripcion = largo.length < 145 ? medio : largo.length <= 162 ? largo : `${r.desc} Checklist gratuito de ${r.items.length} puntos para marcar o guardar como PDF.`;
---

<Layout
  title={`${r.titulo} | Tecnochui`}
  description={descripcion}
>
  <nav aria-label="Ruta" class="text-sm text-gray-400 mb-4 no-print">
    <a href="/recursos">Recursos</a> <span aria-hidden="true">›</span> <span class="text-gray-200">Checklist</span>
  </nav>

  <h1 class="font-display text-3xl md:text-4xl font-bold text-white leading-tight">{r.titulo}</h1>
  <p class="text-lg text-gray-300 mt-3 max-w-3xl leading-relaxed">{r.desc}</p>

  <div class="flex flex-wrap items-center gap-3 mt-5 no-print">
    <button type="button" id="print-btn" class="btn-secondary">Guardar como PDF / imprimir</button>
    <span id="progress" class="text-sm text-gray-400" aria-live="polite"></span>
  </div>

  <ol class="mt-6 space-y-3 max-w-3xl" id="checklist">
    {r.items.map((it, i) => (
      <li>
        <label class="panel panel-static p-4 flex items-start gap-3 cursor-pointer">
          <input type="checkbox" class="mt-1 w-5 h-5 accent-[color:var(--c-primary)] shrink-0" />
          <span class="text-gray-100 leading-relaxed"><strong class="text-primary mr-1">{i + 1}.</strong>{it}</span>
        </label>
      </li>
    ))}
  </ol>

  <section class="panel panel-static panel-glow p-6 mt-10 max-w-3xl no-print">
    <h2 class="font-display text-xl font-bold text-white">¿Marcaste menos de lo que esperabas?</h2>
    <p class="text-gray-300 mt-2 leading-relaxed">
      Es normal: casi nadie cumple todo. Cuéntame qué falta y te hago un diagnóstico gratis para
      decirte por dónde empezar.
    </p>
    <div class="flex flex-wrap gap-3 mt-4">
      <a href={`/contacto${servicio ? `?servicio=${servicio.contacto}` : ''}`} class="btn-primary">Pedir diagnóstico gratis</a>
      <a href={waLink(mensaje)} target="_blank" rel="noopener noreferrer" class="btn-secondary">Escribir por WhatsApp</a>
    </div>
  </section>

  <section class="panel panel-static p-6 mt-5 max-w-3xl no-print">
    <h2 class="font-display text-lg font-bold text-white">Recibe los próximos checklists</h2>
    <p class="text-sm text-gray-300 mt-1">Te aviso cuando publique uno nuevo. Sin spam.</p>
    <form id="subscribe-form" action={SITE.formEndpoint} method="POST" class="mt-4 flex flex-col sm:flex-row gap-3">
      <input type="hidden" name="_subject" value={`Nuevo suscriptor a recursos — ${r.titulo}`} />
      <input type="hidden" name="recurso" value={r.slug} />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <label class="sr-only" for="sub-email">Correo electrónico</label>
      <input id="sub-email" name="email" type="email" required placeholder="tu@correo.com" class="field sm:flex-1" />
      <button type="submit" class="btn-primary" id="sub-btn">Avísame</button>
    </form>
    <p id="sub-status" class="text-sm mt-3 text-gray-400" role="status" aria-live="polite"></p>
  </section>

  {servicio && (
    <p class="text-sm text-gray-400 mt-8 no-print">
      Relacionado: <a href={`/servicios/${servicio.slug}`} class="font-semibold">{servicio.nombre}</a>
    </p>
  )}
</Layout>

<script>
  // Progreso del checklist
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('#checklist input[type="checkbox"]'));
  const progress = document.getElementById('progress');
  const updateProgress = () => {
    const done = boxes.filter((b) => b.checked).length;
    if (progress) progress.textContent = `${done} de ${boxes.length} cumplidos`;
  };
  boxes.forEach((b) => b.addEventListener('change', updateProgress));
  updateProgress();

  document.getElementById('print-btn')?.addEventListener('click', () => window.print());

  // Suscripción (Formspree)
  const form = document.getElementById('subscribe-form') as HTMLFormElement | null;
  const status = document.getElementById('sub-status');
  const btn = document.getElementById('sub-btn') as HTMLButtonElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn) return;
    btn.disabled = true;
    status.textContent = 'Enviando…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        status.textContent = '¡Listo! Te avisaré cuando haya un checklist nuevo.';
        status.className = 'text-sm mt-3 text-primary font-semibold';
        form.reset();
      } else {
        status.textContent = 'No se pudo enviar. Inténtalo de nuevo o escríbeme por WhatsApp.';
      }
    } catch {
      status.textContent = 'Error de red. Inténtalo de nuevo en un momento.';
    } finally {
      btn.disabled = false;
    }
  });
</script>
