---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServicesBento from '../components/ServicesBento.astro';
import { getCollection } from 'astro:content';

// Últimos 3 artículos publicados, leídos de la colección real del blog.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((post) => ({
    title: post.data.title,
    date: post.data.pubDate.toISOString().slice(0, 10),
    href: `/blog/${post.id}/`,
  }));
---

<Layout
  title="tecnochui | infraestructura, ciberseguridad y redes"
  description="Infraestructura, ciberseguridad, virtualización, redes y capacitación técnica en tecnochui."
>
  <Hero />
  <ServicesBento />

  <!-- Sección: últimos artículos -->
  <section class="panel p-6 mt-4">
    <div class="flex items-center gap-2 mb-4">
      <span class="text-secondary">$</span>
      <h2 class="font-display text-lg font-bold text-white">cat ~/blog/ultimos</h2>
    </div>
    <ul class="space-y-1">
      {posts.map((post, i) => (
        <li
          class:list={[
            'flex items-center gap-2 py-2 text-sm',
            i < posts.length - 1 ? 'border-b border-gray-700' : '',
          ]}
        >
          <span class="text-primary">&gt;</span>
          <a href={post.href} class="text-gray-200 hover:text-primary transition">
            {post.title}
          </a>
          <span class="ml-auto text-xs text-gray-500">{post.date}</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>
