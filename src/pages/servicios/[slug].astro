---
import Layout from '../../layouts/Layout.astro';
import { servicios } from '../../data/servicios.js';
import { getRecurso } from '../../data/recursos.js';
import { SITE, waLink } from '../../data/site.js';

export function getStaticPaths() {
  return servicios.map((s) => ({ params: { slug: s.slug }, props: { servicio: s } }));
}

const { servicio: s } = Astro.props;
const recurso = getRecurso(s.recurso);
const otros = servicios.filter((x) => x.slug !== s.slug);
const mensaje = `Hola Jesús, vi tu página de «${s.nombre}» en Tecnochui y quiero pedir un diagnóstico gratis.`;
const contactoHref = `/contacto?servicio=${s.contacto}`;

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.h1,
    description: s.seoDesc,
    url: `${SITE.url}/servicios/${s.slug}/`,
    provider: { '@type': 'ProfessionalService', name: SITE.nombre, url: SITE.url },
    areaServed: [
      { '@type': 'City', name: 'Caracas' },
      { '@type': 'Country', name: 'Venezuela' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout title={s.seoTitle} description={s.seoDesc} jsonLd={ld}>
  <nav aria-label="Ruta" class="text-sm text-gray-400 mb-4">
    <a href="/servicios">Servicios</a> <span aria-hidden="true">›</span> <span class="text-gray-200">{s.nombre}</span>
  </nav>

  <div class="term-only items-center gap-2 text-sm text-gray-400 mb-2">
    <span class="text-primary">$</span><span class="text-white">cat</span>
    <span class="text-secondary">~/servicios/{s.slug}</span>
  </div>

  <h1 class="font-display text-3xl md:text-4xl font-bold text-white leading-tight">{s.h1}</h1>
  <p class="text-lg text-gray-300 mt-4 max-w-3xl leading-relaxed">{s.lead}</p>

  <div class="flex flex-wrap items-center gap-3 mt-6">
    <a href={contactoHref} class="btn-primary">Pedir diagnóstico gratis</a>
    <a href={waLink(mensaje)} target="_blank" rel="noopener noreferrer" class="btn-secondary">Escribir por WhatsApp</a>
  </div>
  <p class="text-sm text-gray-400 mt-3">El diagnóstico es gratis, incluso si hay que hacerlo en sitio.</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-10">
    <section class="panel panel-static p-5">
      <h2 class="font-display text-lg font-bold text-white mb-3">¿Te pasa esto?</h2>
      <ul class="space-y-2 text-sm text-gray-200">
        {s.problemas.map((p) => (
          <li class="flex gap-2"><span class="text-primary mt-0.5">•</span><span>{p}</span></li>
        ))}
      </ul>
    </section>
    <section class="panel panel-static p-5">
      <h2 class="font-display text-lg font-bold text-white mb-3">¿Para quién es?</h2>
      <p class="text-sm text-gray-200 leading-relaxed">{s.paraQuien}</p>
    </section>
  </div>

  <section class="panel panel-static p-5 mt-5">
    <h2 class="font-display text-lg font-bold text-white mb-3">Qué incluye</h2>
    <ul class="space-y-2 text-sm text-gray-200">
      {s.items.map((it) => (
        <li class="flex gap-2"><span class="text-primary mt-0.5">✓</span><span>{it}</span></li>
      ))}
    </ul>
  </section>

  {recurso && (
    <a href={`/recursos/${recurso.slug}`} class="panel panel-glow p-5 mt-5 flex flex-col sm:flex-row sm:items-center gap-3">
      <div>
        <p class="text-xs uppercase tracking-wide text-primary font-semibold">Recurso gratuito</p>
        <p class="font-display font-bold text-white mt-1">{recurso.titulo}</p>
        <p class="text-sm text-gray-300 mt-1">{recurso.desc}</p>
      </div>
      <span class="sm:ml-auto btn-secondary whitespace-nowrap">Abrir checklist →</span>
    </a>
  )}

  <section class="mt-10">
    <h2 class="font-display text-xl font-bold text-white mb-4">Preguntas frecuentes</h2>
    <div class="space-y-3">
      {s.faqs.map((f) => (
        <details class="panel panel-static p-4 group">
          <summary class="cursor-pointer font-semibold text-gray-100 list-none flex items-center justify-between gap-3">
            {f.q}
            <span class="text-primary transition group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
          </summary>
          <p class="text-sm text-gray-300 leading-relaxed mt-3">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-lg font-bold text-white mb-3">Otras áreas</h2>
    <div class="flex flex-wrap gap-2">
      {otros.map((o) => (
        <a href={`/servicios/${o.slug}`} class="badge hover:border-primary/50 hover:text-primary transition">{o.nombre}</a>
      ))}
    </div>
  </section>
</Layout>
