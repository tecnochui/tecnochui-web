---
import Layout from '../../layouts/Layout.astro';
import { servicios } from '../../data/servicios.js';
import { icons } from '../../data/icons.js';
---

<Layout
  title="Servicios de TI para pymes en Caracas | Tecnochui"
  description="Soporte técnico, servidores, virtualización, redes, ciberseguridad y capacitación para pymes en Caracas. Diagnóstico gratis y respuesta en menos de 2 horas."
>
  <div class="mb-8">
    <div class="term-only items-center gap-2 text-sm text-gray-400 mb-2">
      <span class="text-primary">$</span>
      <span class="text-white">ls</span>
      <span class="text-secondary">-la</span>
      <span class="text-gray-400">~/servicios</span>
      <span class="ml-auto text-xs badge text-gray-400">[ {servicios.length} ÁREAS ]</span>
    </div>
    <h1 class="font-display text-3xl md:text-4xl font-bold text-white">Servicios de TI para pymes en Caracas</h1>
    <p class="text-gray-300 mt-3 max-w-2xl leading-relaxed">
      Seis áreas de trabajo, un solo responsable. Elige la que se parece a tu problema o escríbeme y lo
      revisamos juntos: el diagnóstico es gratis.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {servicios.map((s) => (
      <a href={`/servicios/${s.slug}`} class="panel p-5 flex flex-col group">
        <div class="flex items-center gap-3 mb-3 pb-3 border-b border-gray-700">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded border border-gray-700 text-primary shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true">
              <path d={icons[s.icon]} />
            </svg>
          </span>
          <h2 class="font-display text-lg font-bold text-white">{s.nombre}</h2>
        </div>
        <p class="text-gray-300 text-sm leading-relaxed">{s.corto}</p>
        <ul class="mt-3 space-y-1 text-sm text-gray-400">
          {s.problemas.slice(0, 3).map((p) => (
            <li class="flex gap-2"><span class="text-primary">•</span><span>{p}</span></li>
          ))}
        </ul>
        <span class="mt-4 text-sm font-semibold text-secondary group-hover:text-primary transition">Ver detalle →</span>
      </a>
    ))}
  </div>

  <div class="panel panel-static panel-glow mt-10 p-6 text-center">
    <p class="text-gray-200 mb-4">¿Necesitas algo a medida o no sabes en qué área cae tu problema?</p>
    <a href="/contacto" class="btn-primary">Pedir diagnóstico gratis</a>
  </div>
</Layout>
