---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

// Datos mock de artículos
const posts = [
  {
    titulo: 'Cómo la IA está transformando el desarrollo web',
    descripcion: 'Descubre cómo la inteligencia artificial está cambiando la forma en que construimos sitios web.',
    fecha: '15 de julio, 2026',
    url: '/blog/ia-desarrollo-web',
  },
  {
    titulo: '5 tendencias de marketing digital para 2026',
    descripcion: 'Las estrategias que dominarán el marketing digital este año.',
    fecha: '10 de julio, 2026',
    url: '/blog/tendencias-marketing-2026',
  },
  {
    titulo: 'Optimización de rendimiento en sitios modernos',
    descripcion: 'Técnicas avanzadas para que tu sitio web cargue en milisegundos.',
    fecha: '5 de julio, 2026',
    url: '/blog/optimizacion-rendimiento',
  },
];
---

<Layout title="Blog | tecnochui">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl font-bold text-gray-900">Blog</h1>
    <p class="mt-2 text-gray-600">Artículos y noticias sobre tecnología e innovación.</p>
    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <Card
          titulo={post.titulo}
          descripcion={post.descripcion}
          icono="📝"
          url={post.url}
        />
      ))}
    </div>
  </div>
</Layout>