---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada | Tecnochui"
  description="La página que buscas no existe o cambió de lugar. Vuelve al inicio, revisa los servicios de Tecnochui o escríbeme para pedir un diagnóstico gratis."
  noindex
>
  <section class="text-center py-16">
    <p class="font-display text-6xl font-bold text-primary text-glow">404</p>
    <h1 class="font-display text-2xl md:text-3xl font-bold text-white mt-4">Esta página no existe</h1>
    <p class="text-gray-300 mt-3">Puede que el enlace haya cambiado. Estos accesos te pueden ayudar:</p>
    <div class="flex flex-wrap justify-center gap-3 mt-6">
      <a href="/" class="btn-primary">Ir al inicio</a>
      <a href="/servicios" class="btn-secondary">Ver servicios</a>
      <a href="/contacto" class="btn-secondary">Contacto</a>
    </div>
  </section>
</Layout>
