---
import { SITE, waLink, WA_DIAGNOSTICO } from '../data/site.js';

const stats = [
  { n: '+18', t: 'años en soporte técnico de PC y laptops' },
  { n: '+8', t: 'años en infraestructura, redes y servidores' },
  { n: '+10', t: 'años trabajando con Linux' },
  { n: '< 2 h', t: 'de respuesta en horario laboral' },
];
---

<section class="py-6 md:py-12">
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-center">
    <!-- Mensaje principal -->
    <div class="lg:col-span-3">
      <span class="eyebrow mb-4">Soporte de TI para pymes · {SITE.ciudad}</span>

      <h1 class="font-display text-4xl md:text-5xl font-bold leading-[1.08] mt-3 text-white">
        Tecnología que funciona,{' '}
        <span class="text-primary text-glow">para que tu negocio no se detenga.</span>
      </h1>

      <p class="text-base md:text-lg text-gray-300 max-w-xl leading-relaxed mt-5">
        Soporte técnico, redes, servidores, ciberseguridad y desarrollo web a la medida con IA para pymes,
        profesionales y personas en Venezuela. Detrás de Tecnochui estoy yo, Jesús Andrade: atiendo tu caso de principio a fin.
      </p>

      <div class="flex flex-wrap items-center gap-3 mt-7">
        <a href="/contacto" class="btn-primary">Pedir diagnóstico gratis</a>
        <a href={waLink(WA_DIAGNOSTICO)} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          Escribir por WhatsApp
        </a>
      </div>

      <p class="text-sm text-gray-400 mt-4">
        El diagnóstico es gratis. Si hace falta una visita técnica en sitio, se cotiza aparte.
      </p>
    </div>

    <!-- Credenciales -->
    <div class="lg:col-span-2 panel panel-static panel-glow overflow-hidden">
      <div class="term-only items-center gap-2 px-4 py-3 border-b border-gray-700 bg-bg-raised">
        <span class="w-2.5 h-2.5 rounded-full bg-gray-600"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-gray-600"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
        <span class="ml-3 text-xs text-gray-400">tecnochui — resumen</span>
      </div>

      <div class="p-5">
        <p class="text-xs uppercase tracking-wide text-gray-400 mb-4">Experiencia comprobable</p>
        <dl class="grid grid-cols-2 gap-4">
          {stats.map((s) => (
            <div>
              <dt class="font-display text-3xl font-bold text-primary text-glow">{s.n}</dt>
              <dd class="text-sm text-gray-300 leading-snug mt-1">{s.t}</dd>
            </div>
          ))}
        </dl>
        <hr class="divider my-5" />
        <p class="text-sm text-gray-300 leading-relaxed">
          Gerente de Redes y Soporte Técnico de la Dirección de TI de la Alcaldía de Chacao.{' '}
          <a href="/sobre-mi" class="font-semibold whitespace-nowrap">Conoce mi trayectoria →</a>
        </p>
      </div>
    </div>
  </div>
</section>
