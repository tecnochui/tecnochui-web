---
import { SITE, waLink, WA_DIAGNOSTICO } from '../data/site.js';
import { servicios } from '../data/servicios.js';

const year = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/recursos', label: 'Recursos gratuitos' },
  { href: '/blog', label: 'Blog' },
  { href: '/contacto', label: 'Contacto' },
];
---

<footer class="border-t border-gray-700 bg-bg-raised mt-12">
  <div class="container mx-auto max-w-6xl px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-[1.2fr_1fr_1fr_1.4fr] gap-8 text-sm">
      <!-- Marca -->
      <div class="md:col-span-1">
        <a href="/" aria-label="Tecnochui — inicio" class="inline-block mb-3">
          <img src="/logo-claro.png" alt="Tecnochui" width="143" height="26" class="logo-light h-7 w-auto object-contain" />
          <img src="/logo.png" alt="Tecnochui" width="143" height="26" class="logo-dark h-7 w-auto object-contain" />
        </a>
        <p class="text-gray-300 leading-relaxed">
          Soporte técnico, redes, servidores, ciberseguridad y desarrollo con IA para pymes y personas en {SITE.ciudad}, {SITE.pais}.
        </p>
        <p class="text-gray-500 text-xs mt-4">
          &copy; {year} {SITE.nombre}. Todos los derechos reservados.
        </p>
      </div>

      <!-- Servicios -->
      <div>
        <h4 class="text-white font-display font-bold mb-3">Servicios</h4>
        <ul class="space-y-1.5">
          {servicios.map((s) => (
            <li>
              <a href={`/servicios/${s.slug}`} class="text-gray-300 hover:text-primary transition">{s.nombre}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Navegación -->
      <div>
        <h4 class="text-white font-display font-bold mb-3">El sitio</h4>
        <ul class="space-y-1.5">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-300 hover:text-primary transition">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto y redes -->
      <div>
        <h4 class="text-white font-display font-bold mb-3">Contacto</h4>
        <ul class="space-y-1.5 text-gray-300">
          <li>
            <a href={waLink(WA_DIAGNOSTICO)} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition">
              WhatsApp {SITE.telefono}
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="hover:text-primary transition break-words">{SITE.email}</a>
          </li>
          <li>{SITE.ciudad}, {SITE.pais}</li>
          <li class="text-xs text-gray-500">Respuesta en {SITE.respuesta}</li>
        </ul>

        <div class="mt-4 flex flex-wrap gap-2">
          {SITE.redes.map((red) => (
            <a
              href={red.href}
              target="_blank"
              rel="noopener noreferrer"
              class="badge hover:border-primary/50 hover:text-primary transition"
            >
              {red.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
