---
// Botón reutilizable con variantes
export interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { variant = 'primary', href, type = 'button' } = Astro.props;

const classes = {
  primary: 'bg-blue-600 text-white hover:bg-blue-700',
  secondary: 'bg-gray-200 text-gray-800 hover:bg-gray-300',
  outline: 'border border-blue-600 text-blue-600 hover:bg-blue-50',
};

const baseClass = 'px-4 py-2 rounded-md text-sm font-medium transition inline-block';
const classNames = `${baseClass} ${classes[variant]}`;
---

{
  href ? (
    <a href={href} class={classNames}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classNames}>
      <slot />
    </button>
  )
}