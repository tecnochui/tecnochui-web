---
import { servicios } from '../data/servicios.js';
import { icons } from '../data/icons.js';
---

<section class="py-8 md:py-10">
  <div class="max-w-2xl mb-8">
    <span class="eyebrow mb-3">Qué hago por tu negocio</span>
    <h2 class="font-display text-2xl md:text-3xl font-bold text-white mt-2">
      Seis áreas de trabajo, <span class="text-primary text-glow">un solo responsable</span>.
    </h2>
    <p class="text-gray-300 mt-3 leading-relaxed">
      Desde la PC que no enciende hasta la seguridad de toda tu red. Cada área tiene su propia
      página con los problemas que resuelve, lo que incluye y preguntas frecuentes.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {servicios.map((s) => (
      <a href={`/servicios/${s.slug}`} class="panel p-6 flex flex-col justify-between group no-underline">
        <div>
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded border border-gray-700 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true">
                <path d={icons[s.icon]} />
              </svg>
            </span>
            <span class="badge term-only text-gray-400">{s.term}</span>
          </div>

          <h3 class="font-display font-bold text-white mt-4 text-lg leading-snug">{s.nombre}</h3>
          <p class="text-gray-300 mt-2 leading-relaxed text-sm">{s.corto}</p>
        </div>

        <span class="inline-flex items-center gap-1 text-sm font-semibold text-secondary group-hover:text-primary transition mt-5">
          Ver detalle <span class="transition group-hover:translate-x-0.5">→</span>
        </span>
      </a>
    ))}
  </div>
</section>
