---
// Componente Card para mostrar servicios, posts, etc.
export interface Props {
  titulo: string;
  descripcion: string;
  icono?: string;
  url?: string;
}

const { titulo, descripcion, icono, url } = Astro.props;
---

<div class="bg-white rounded-xl shadow-md hover:shadow-lg transition p-6 border border-gray-100 flex flex-col items-start">
  {icono && (
    <div class="text-4xl mb-4">{icono}</div>
  )}
  <h3 class="text-xl font-bold text-gray-900">{titulo}</h3>
  <p class="mt-2 text-gray-600 text-sm flex-1">{descripcion}</p>
  {url && (
    <a href={url} class="mt-4 text-blue-600 font-medium text-sm hover:underline">
      Ver más →
    </a>
  )}
</div>