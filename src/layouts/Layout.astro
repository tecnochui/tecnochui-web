---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

/**
 * @typedef {Object} Props
 * @property {string} [title]
 * @property {string} [description]
 */

const { title = 'tecnochui', description = 'Soluciones tecnológicas en terminal' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- TODO: agregar favicon.svg en /public cuando esté listo, y volver a enlazarlo aquí -->
  </head>
  <body>
    <Header />
    <main class="flex-1 container mx-auto px-4 py-8 max-w-4xl fade-in">
      <slot />
    </main>
    <Footer />
  </body>
</html>
